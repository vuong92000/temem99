# VideoAI Studio server configuration
# Copy this file to .env, fill the values, then restart npm start.
# Do not commit .env or paste secrets into chat.

# =========================
# Agnes AI self-hosted service
# =========================
AGNES_URL=http://127.0.0.1:8765
# Optional, only if Agnes requires an API key:
AGNES_API_KEY=

# =========================
# Gemini image: simplest API-key mode
# =========================
# Get a Gemini API key from Google AI Studio and put it here.
# The key stays server-side; it is never sent to browser JavaScript.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# =========================
# Optional Google OAuth mode
# =========================
# OAuth is only needed when users must sign in with their own Google Cloud permission.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

# Use the exact callback URL registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# For an Arena/tunnel/domain preview, replace the line above with:
# GOOGLE_OAUTH_REDIRECT_URI=https://your-public-host.example/api/google/oauth/callback
